{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "ollama"
  ],
  "model": "ollama/qwen3.5:4b",
  "small_model": "ollama/qwen3.5:4b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3.5:4b": {
          "name": "Qwen3.5 4B local",
          "limit": {
            "context": 4096,
            "output": 512
          }
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "ask",
    "external_directory": "deny",
    "bash": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
